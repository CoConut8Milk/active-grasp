<?xml version="1.0"?>
<!--
  ag_arm: a tabletop 6-DOF arm (UR5-like geometry) with a parallel
  two-finger gripper and an eye-in-hand RGB-D camera.

  All links are built from primitive shapes so the package has zero
  mesh dependencies. Geometry conventions:
    - base_link origin sits on the table surface, +z up, +x forward.
    - tool0 z-axis points from the wrist toward the fingertips.
    - camera_link x-axis is the camera viewing direction (Gazebo Classic
      cameras look along +x), parallel to the tool0 z-axis.
  The same joints/origins are parsed at runtime by ag_execution for FK/IK,
  so keep this file and kinematics.py consistent.
-->
<robot name="ag_arm">

  <material name="ag_dark">
    <color rgba="0.25 0.27 0.3 1.0"/>
  </material>
  <material name="ag_steel">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>
  <material name="ag_orange">
    <color rgba="0.92 0.42 0.12 1.0"/>
  </material>
  <material name="ag_black">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>

  <!-- ======================= base ======================= -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.16 0.16 0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="ag_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.16 0.16 0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="0.0067" ixy="0" ixz="0" iyy="0.0067" iyz="0" izz="0.0085"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="80" velocity="2.0"/>
  </joint>

  <!-- ======================= shoulder ======================= -->
  <link name="shoulder_link">
    <visual>
      <geometry>
        <cylinder radius="0.06" length="0.18"/>
      </geometry>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <material name="ag_steel"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.06" length="0.18"/>
      </geometry>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.09"/>
      <inertia ixx="0.00288" ixy="0" ixz="0" iyy="0.00288" iyz="0" izz="0.00144"/>
    </inertial>
  </link>

  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="80" velocity="2.0"/>
  </joint>

  <!-- ======================= upper arm ======================= -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <box size="0.07 0.07 0.32"/>
      </geometry>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
      <material name="ag_orange"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.07 0.07 0.32"/>
      </geometry>
      <origin xyz="0 0 0.16" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.2"/>
      <origin xyz="0 0 0.16"/>
      <inertia ixx="0.01073" ixy="0" ixz="0" iyy="0.01073" iyz="0" izz="0.00098"/>
    </inertial>
  </link>

  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.8" upper="2.8" effort="60" velocity="2.5"/>
  </joint>

  <!-- ======================= forearm ======================= -->
  <link name="forearm_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <material name="ag_steel"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.30"/>
      </geometry>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.9"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.00702" ixy="0" ixz="0" iyy="0.00702" iyz="0" izz="0.00054"/>
    </inertial>
  </link>

  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist1_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="40" velocity="3.0"/>
  </joint>

  <!-- ======================= wrist 1 ======================= -->
  <link name="wrist1_link">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <material name="ag_orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.045" length="0.12"/>
      </geometry>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin xyz="0 0 0.06"/>
      <inertia ixx="0.00068" ixy="0" ixz="0" iyy="0.00068" iyz="0" izz="0.00041"/>
    </inertial>
  </link>

  <joint name="joint5" type="revolute">
    <parent link="wrist1_link"/>
    <child link="wrist2_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="3.0"/>
  </joint>

  <!-- ======================= wrist 2 ======================= -->
  <link name="wrist2_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <material name="ag_steel"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.10"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.05"/>
      <inertia ixx="0.00037" ixy="0" ixz="0" iyy="0.00037" iyz="0" izz="0.00024"/>
    </inertial>
  </link>

  <joint name="joint6" type="revolute">
    <parent link="wrist2_link"/>
    <child link="wrist3_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="30" velocity="3.0"/>
  </joint>

  <!-- ======================= wrist 3 / tool flange ======================= -->
  <link name="wrist3_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="ag_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.00010" ixy="0" ixz="0" iyy="0.00010" iyz="0" izz="0.00010"/>
    </inertial>
  </link>

  <joint name="tool0_joint" type="fixed">
    <parent link="wrist3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- tool0 must carry an inertial: Gazebo merges ("lumps") fixed joints into
       the parent link, and a massless lumped link takes its child joints
       (the two gripper fingers) down with it. -->
  <link name="tool0">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="5e-06" ixy="0" ixz="0" iyy="5e-06" iyz="0" izz="5e-06"/>
    </inertial>
  </link>

  <!-- ======================= gripper fingers ======================= -->
  <!-- q=0 is open (gap 4 cm); q=0.018 is closed (gap 0.4 cm). -->
  <joint name="finger_left" type="prismatic">
    <parent link="tool0"/>
    <child link="finger_left_link"/>
    <origin xyz="-0.036 0 -0.01" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.018" effort="25" velocity="0.03"/>
  </joint>

  <link name="finger_left_link">
    <visual>
      <geometry>
        <box size="0.02 0.026 0.06"/>
      </geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <material name="ag_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.026 0.06"/>
      </geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.03"/>
      <inertia ixx="0.0000167" ixy="0" ixz="0" iyy="0.0000161" iyz="0" izz="0.0000027"/>
    </inertial>
  </link>

  <joint name="finger_right" type="prismatic">
    <parent link="tool0"/>
    <child link="finger_right_link"/>
    <origin xyz="0.036 0 -0.01" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="0" upper="0.018" effort="25" velocity="0.03"/>
  </joint>

  <link name="finger_right_link">
    <visual>
      <geometry>
        <box size="0.02 0.026 0.06"/>
      </geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <material name="ag_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.026 0.06"/>
      </geometry>
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 -0.03"/>
      <inertia ixx="0.0000167" ixy="0" ixz="0" iyy="0.0000161" iyz="0" izz="0.0000027"/>
    </inertial>
  </link>

  <!-- ======================= camera ======================= -->
  <joint name="camera_joint" type="fixed">
    <parent link="wrist3_link"/>
    <child link="camera_link"/>
    <origin xyz="0.06 0 0.04" rpy="0 -1.5708 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="ag_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.06 0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.000076" ixy="0" ixz="0" iyy="0.000043" iyz="0" izz="0.000056"/>
    </inertial>
  </link>

  <!-- ======================= gazebo plugins ======================= -->
  <gazebo reference="finger_left_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>
  <gazebo reference="finger_right_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <!-- Gazebo Classic lumps fixed joints by default. Without the flags below
       tool0 / camera_link disappear from the SDF and the finger joints that
       hang off tool0 are dropped, which makes gazebo_ros2_control print
       "Skipping joint in the URDF named 'finger_left' which is not in the
       gazebo model" and the gripper controller fail to activate. -->
  <gazebo reference="tool0_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>__AG_CONTROLLERS_YAML__</parameters>
      <!-- 位置命令接口在插件里是按 P 控制器实现的（默认增益 0.1 太小，
           重力和仿真步长会让机械臂以 ~0.1 rad/s 缓慢下沉漂移）。调大增益
           后机械臂能真正"站住"，感知标定与抓取精度都会明显变好。 -->
      <position_proportional_gain>10.0</position_proportional_gain>
    </plugin>
  </gazebo>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="finger_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo reference="camera_link">
    <sensor name="ag_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>15.0</update_rate>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047197551</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>2.0</far>
        </clip>
      </camera>
      <plugin name="ag_camera_plugin" filename="libgazebo_ros_camera.so">
        <frame_name>camera_link</frame_name>
        <camera_name>ag_camera</camera_name>
        <min_depth>0.05</min_depth>
        <max_depth>2.0</max_depth>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>
